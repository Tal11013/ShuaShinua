# Copy this file to .env.local for local development and fill in real values.
# Supabase values are in the dashboard: Project Settings → API.
# In production, set these in the hosting dashboards instead (never commit them).

# ---- Client (Vercel) ----
# Exposed to the browser: only VITE_* and NEXT_PUBLIC_* vars reach the client
# bundle (envPrefix in vite.config.ts). They are baked in at build time, so
# redeploy after changing them.

# URL of the Express API on Render, no trailing slash.
# Leave unset locally: the Vite dev server proxies /api to localhost:3001.
VITE_API_URL=https://your-api.onrender.com

# ---- Server (Render) ----
# Origin(s) of the deployed client, comma-separated, no trailing slash.
# Defaults to http://localhost:5173 (the Vite dev server).
CLIENT_URL=https://your-app.vercel.app

# Render sets PORT automatically; defaults to 3001 locally.
PORT=3001

# Chat agent (agent/server.py). The browser never calls it directly: this
# server proxies /api/chat and /agent-assets to it.
# Defaults to http://localhost:8000; on Render, the agent service's URL.
AGENT_URL=https://your-agent.onrender.com
# Shared secret; must match AGENT_TOKEN in agent/.env. Set it when deployed.
AGENT_TOKEN=a-long-random-string

# The server reaches the database through Supabase (there is no DATABASE_URL).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only: bypasses Row Level Security. Never expose it to the browser
# (no VITE_/NEXT_PUBLIC_ prefix) and never set it on Vercel.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Tooling (local only) ----
# Used by `npm run db:gen-types`.
SUPABASE_PROJECT_ID=your-project-ref
SUPABASE_ACCESS_TOKEN=your-personal-access-token
