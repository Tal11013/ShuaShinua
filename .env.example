# Supabase — copy this file to .env.local and fill in real values.
# Find them in the Supabase dashboard: Project Settings → API.

# Public (exposed to the browser via Vite's envPrefix)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose this to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used by `npm run db:gen-types`
SUPABASE_PROJECT_ID=your-project-ref
