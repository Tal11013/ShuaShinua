# Copy to agent/.env and fill in. Never commit agent/.env.

# Postgres connection string for the Supabase project:
# Dashboard → Connect → Connection string (URI). Prefer the session pooler URI.
# The SQL tool runs read-only, but a login limited to SELECT is safer still.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres

# Shared secret: must match AGENT_TOKEN in the Express server's env.
# Leave empty locally to skip the check; always set it when deployed.
AGENT_TOKEN=

# LLM providers: set at least the one your chosen model uses.
LOGFARE_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
# Ollama over a tunnel, e.g. from Colab (optional).
COLAB_API_BASE=
